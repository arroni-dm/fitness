# GEMINI_API_KEY: Optional AI Studio environment secret.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / PUBLIC_SITE_URL: Canonical base URL where the site is hosted.
APP_URL="MY_APP_URL"
PUBLIC_SITE_URL=""

# BUSINESS CONFIGURATION (Server & Public Hydration)
# Set these values to replace development placeholders with live business details.
BUSINESS_NAME="[COACH BRAND NAME]"
BUSINESS_PHONE=""
BUSINESS_EMAIL=""

# LEAD STORAGE & DELIVERY
# Leads are stored persistently on the server in SQLite/JSON storage (./data/leads.sqlite).
# Optional: Configure a webhook (CRM / Zapier / Make) or Resend transactional email key for instant notifications.
SQLITE_DB_PATH="./data/leads.sqlite"
LEAD_WEBHOOK_URL=""
EMAIL_SERVICE_API_KEY=""
LEAD_NOTIFICATION_EMAIL=""

# ADMIN PROTECTION
# Required Bearer token to read stored leads via GET /api/leads
ADMIN_API_TOKEN=""

# ANALYTICS (Optional — tracking stays disabled until valid IDs are configured)
VITE_GA_MEASUREMENT_ID=""
VITE_GTM_ID=""
